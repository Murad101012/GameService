.screen-root {
    flex-grow: 1;
    justify-content: center;
    padding-top: 1.5%;
    padding-bottom: 1.5%;
}

.cont-carousel-viewport {
    flex-direction: row;
    align-items: center;
    width: 100%;
    height: 80%;
}

.cont-carousel-film-level-viewport {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    top: 0;
    bottom: 0;
    flex-grow: 1;
    min-width: 100%;
    height: 100%;
    background-color: transparent;
}

.btn-level {
    position: absolute;
    align-content: center;
    height: 80%;
    aspect-ratio: 1;
    border-radius: 50%;
    background-color: white;
    justify-content: center;
    align-items: center;
    flex-shrink: 0;
    flex-grow: 0;
    flex-basis: auto;
}

.btn-level-image {
    height: 90%;
    aspect-ratio: 1;
    border-radius: 50%;
    -unity-background-scale-mode: scale-and-crop;
}

.lbl-level-title {
    color: white;
    -unity-text-outline-color: gray;
    -unity-text-outline: gray;
    -unity-text-outline-width: 2px;
    opacity: 1;
    align-self: center;
    height: auto;
    font-size: 65px;
    -unity-font-style: bold;
    -unity-font-definition: url("project://database/Assets/TextMesh%20Pro/Fonts/LiberationSans.ttf?fileID=12800000&guid=e3265ab4bf004d28a9537516768c1c75&type=3#LiberationSans");
}

.btn-level-disc-dot {
    background-color: black;
    height: 5%;
    width: 5%;
    aspect-ratio: 1;
    border-radius: 50%;
}

#unity-dragger {
    border-color: transparent;
    border-width: 0;
    margin: 0;
    aspect-ratio: 1;
    border-radius: 50%;
    width: 35px;
    height: 35px;
    top: -10%;
}

#unity-tracker {
    border-color: papayawhip;
    background-color: white;
    height: 50%;
    margin-left: 1%;
    margin-right: 1%;
}

.u-hide {
    display: none;
}

.u-flex-spacer {
    flex-grow: 1;
}

.btn-profile {
    position: absolute;
    top: 24px;
    right: 24px;
    width: 90px;
    height: 90px;
    border-radius: 50%;
    font-size: 45px;
    background-color: rgba(30, 30, 40, 0.85);
    color: white;
    border-width: 2px;
    border-color: white;
    justify-content: center;
    align-items: center;
}

.social-layer {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    right: 0;
    background-color: rgba(0, 0, 0, 0.85);
    justify-content: center;
    align-items: center;
}

.social-window {
    width: 70%;
    height: 70%;
    flex-direction: column;
    background-color: rgb(22, 22, 30);
    border-radius: 18px;
    border-width: 2px;
    border-color: rgb(90, 90, 120);
    padding-top: 20px;
    padding-bottom: 20px;
    padding-left: 24px;
    padding-right: 24px;
    align-items: stretch;
}

.social-title {
    color: white;
    font-size: 32px;
    -unity-font-style: bold;
    align-self: center;
    margin-bottom: 8px;
}

.social-scroll {
    flex-grow: 1;
    min-height: 0;
}

.social-view {
    flex-direction: column;
    flex-shrink: 1;
}

.social-tabs {
    flex-direction: row;
    justify-content: center;
    margin-bottom: 12px;
    flex-wrap: wrap;
}

.social-tab {
    margin-left: 6px;
    margin-right: 6px;
    margin-top: 4px;
    margin-bottom: 4px;
    padding-left: 14px;
    padding-right: 14px;
    padding-top: 6px;
    padding-bottom: 6px;
    font-size: 20px;
    border-radius: 10px;
    flex-shrink: 1;
}

.social-tab-active {
    background-color: rgb(70, 120, 200);
    color: white;
}

.social-field {
    margin-bottom: 8px;
    flex-direction: row;
    align-items: center;
}

.social-field > .unity-label {
    color: rgb(200, 200, 210);
    font-size: 20px;
    width: 35%;
    flex-shrink: 0;
    margin-right: 8px;
    white-space: normal;
}

.social-field > .unity-text-field__input {
    font-size: 22px;
    flex-grow: 1;
}

.social-process {
    margin-top: 10px;
    padding-top: 8px;
    padding-bottom: 8px;
    font-size: 24px;
    border-radius: 10px;
}

.social-list {
    flex-grow: 1;
    min-height: 120px;
    background-color: rgba(255, 255, 255, 0.05);
    border-radius: 10px;
    padding-left: 10px;
    padding-right: 10px;
    padding-top: 8px;
    padding-bottom: 8px;
}

.social-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 6px;
    padding-top: 4px;
    padding-bottom: 4px;
}

.social-row-label {
    color: white;
    font-size: 20px;
    flex-grow: 1;
}

.social-row-btn {
    font-size: 18px;
    margin-left: 8px;
    padding-left: 12px;
    padding-right: 12px;
    border-radius: 8px;
}

.social-search-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 12px;
}

.social-search-wrap {
    flex-grow: 1;
    margin-right: 8px;
}

.social-search-placeholder {
    position: absolute;
    color: rgb(150, 150, 150);
    font-size: 22px;
    margin-left: 10px;
    margin-top: 8px;
}

.social-message {
    color: rgb(255, 200, 100);
    font-size: 20px;
    align-self: center;
    margin-top: 8px;
    white-space: normal;
}

.social-back {
    margin-top: 10px;
    padding-top: 8px;
    padding-bottom: 8px;
    font-size: 22px;
    border-radius: 10px;
}

.social-caption {
    color: rgb(200, 200, 210);
    font-size: 20px;
    margin-bottom: 2px;
}

.social-birth-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 8px;
}

.social-birth-label {
    color: rgb(200, 200, 210);
    font-size: 20px;
    margin-left: 4px;
    margin-right: 6px;
}

.social-birth-field {
    flex-grow: 1;
}

.social-birth-field .unity-text-field__input {
    font-size: 20px;
}

.social-auth-row {
    flex-direction: row;
    margin-bottom: 8px;
}

.social-remember {
    font-size: 20px;
}

.social-remember .unity-toggle__label {
    color: rgb(200, 200, 210);
    font-size: 20px;
}

.social-auth-pair {
    flex-grow: 1;
    flex-basis: 0;
    flex-direction: column;
    margin-left: 4px;
    margin-right: 4px;
}

.social-auth-pair .unity-text-field__input {
    font-size: 20px;
}

.social-search-wrap .unity-text-field__input {
    font-size: 20px;
}

.social-gender-row {
    flex-direction: row;
    flex-wrap: wrap;
}

.social-danger {
    background-color: rgb(170, 30, 30);
    color: white;
    border-width: 2px;
    border-color: rgb(255, 90, 90);
}
